<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- যখন ইডিটেক্সট এ ফোকাস থাকবে (Active Box) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#FFFFFF" />
            <stroke android:width="1.5dp" android:color="@color/primary" /> <!-- প্রাইমারি কালার -->
        </shape>
    </item>

    <!-- নরমাল অবস্থা (Inactive Box) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/beautifulWhite" />
            <stroke android:width="1dp" android:color="@color/greyBorder" />
        </shape>
    </item>

</selector>