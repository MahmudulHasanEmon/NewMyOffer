<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ToolbarTitleStyle">
        <item name="android:textSize">@dimen/_toolbarText</item>
        <item name="android:fontFamily">@font/bangla_medium</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="_keyboard">
        <item name="android:textSize">@dimen/_24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:fontFamily">@font/bangla_bold</item>
        <item name="android:padding">@dimen/_0dp</item>
        <item name="android:minWidth">0dp</item>
    </style>

    <style name="RoundedTabLayoutStyle">
        <item name="tabTextColor">@color/black</item>
        <item name="tabSelectedTextColor">@color/primary</item>
        <item name="tabTextAppearance">@style/tabTextAppearance</item>
        <item name="tabSelectedTextAppearance">@style/tabSelectedTextAppearance</item>
    </style>

    <style name="tabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">@dimen/_13sp</item>
        <item name="android:fontFamily">@font/bangla_medium</item>
    </style>

    <style name="tabSelectedTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">@dimen/_13sp</item>
        <item name="android:fontFamily">@font/bangla_bold</item>
    </style>

    <style name="TopRoundedCard">
        <item name="cornerFamily">rounded</item>

        <item name="cornerSizeTopLeft">@dimen/_10dp</item>
        <item name="cornerSizeTopRight">@dimen/_10dp</item>

        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="BottomRoundedCard">
        <item name="cornerFamily">rounded</item>

        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>

        <item name="cornerSizeBottomLeft">@dimen/_10dp</item>
        <item name="cornerSizeBottomRight">@dimen/_10dp</item>
    </style>

    <style name="DialogAnimation">

        <item name="android:windowEnterAnimation">@anim/dialog_scale</item>

        <item name="android:windowExitAnimation">@anim/dialog_scale_out</item>

    </style>

</resources>