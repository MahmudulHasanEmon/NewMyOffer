<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/top_corner_carb">

    <RelativeLayout
        android:id="@+id/topLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/_10dp">

        <TextView
            android:id="@+id/t1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:fontFamily="@font/bangla_medium"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="0.9"
            android:text="অপারেটর বেছে নিন \nএই নাম্বারের বর্তমান অপারেটর বেছে নিন "
            android:textColor="@color/black"
            android:textSize="@dimen/_15sp" />

        <TextView
            android:id="@+id/cancelButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_ripple_primary"

            android:layout_centerVertical="true"
            android:fontFamily="@font/bangla_medium"
            android:text="বাতিল করুন"
            android:textColor="@android:color/holo_red_dark"
            android:textSize="@dimen/_13sp" />


    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1.5dp"
        android:layout_below="@id/topLayout"
        android:background="@color/beautifulWhite" />

    <GridView
        android:id="@+id/gridView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/topLayout"
        android:numColumns="4"
        android:background="@color/beautifulWhite"
        android:padding="@dimen/_10dp"
        tools:listitem="@layout/recharge_operator_item" />


</RelativeLayout>