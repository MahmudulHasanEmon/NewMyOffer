<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/bg_ripple_primary"
    >

    <LinearLayout
        android:gravity="center_vertical"
        android:padding="@dimen/_10dp"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.holystock.newmyoffer.views.BorderView
            android:layout_width="@dimen/_37dp"
            android:layout_height="@dimen/_37dp"
            android:layout_centerInParent="true"
            android:padding="@dimen/_7dp"
            app:bgColor="#59dddddd"
            app:borderColor="@color/white"
            app:borderWidth="@dimen/_0dp"
            app:cornerRadius="@dimen/_100dp">

            <ImageView
                android:id="@+id/icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:src="@drawable/wallet" />


        </com.holystock.newmyoffer.views.BorderView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="@dimen/_0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:orientation="vertical"
                android:paddingStart="@dimen/_10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bangla_medium"
                    android:includeFontPadding="false"
                    android:text="এড মানি"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:firstBaselineToTopHeight="0dp"
                    android:fontFamily="@font/bangla"
                    android:includeFontPadding="false"
                    android:lastBaselineToBottomHeight="0dp"
                    android:maxLines="1"
                    android:padding="0dp"
                    android:text="bKash payment - 01845416702"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sp" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bangla"
                    android:includeFontPadding="false"
                    android:text="TrxID: H0KF54GEZI"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sp" />


            </LinearLayout>

            <LinearLayout
                android:layout_width="@dimen/_0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical"
                android:paddingStart="@dimen/_10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/bangla_bold"
                    android:includeFontPadding="false"
                    android:text="+ ৳100.00"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/_14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:firstBaselineToTopHeight="0dp"
                    android:fontFamily="@font/bangla"
                    android:includeFontPadding="false"
                    android:lastBaselineToBottomHeight="0dp"
                    android:maxLines="1"
                    android:padding="0dp"
                    android:text="10:21 AM 12/05/2026"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12sp" />


                <com.holystock.newmyoffer.views.BorderView
                    android:layout_width="@dimen/_22dp"
                    android:layout_height="@dimen/_22dp"
                    android:layout_centerInParent="true"
                    android:padding="@dimen/_5dp"
                    android:clickable="true"
                    android:foreground="?selectableItemBackground"
                    app:bgColor="#59dddddd"
                    app:borderColor="@color/white"
                    app:borderWidth="@dimen/_0dp"
                    app:cornerRadius="@dimen/_100dp">

                    <ImageView
                        android:id="@+id/icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:src="@drawable/twotone_arrow_forward_ios_24"
                        app:tint="@color/black" />


                </com.holystock.newmyoffer.views.BorderView>

            </LinearLayout>


        </LinearLayout>

    </LinearLayout>

    <View
        android:background="@color/greyLight"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_0.5dp"/>

</LinearLayout>