<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/_270dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:layout_marginTop="@dimen/_5dp"
    android:background="@android:color/transparent"
    android:outlineAmbientShadowColor="@color/primary"
    android:outlineSpotShadowColor="@color/primary"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="@dimen/_10dp"
    app:cardElevation="@dimen/_1dp"
    app:strokeColor="@color/primary"
    app:strokeWidth="@dimen/_0.5dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_15dp"
        android:paddingVertical="@dimen/_10dp">


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.holystock.newmyoffer.views.IconTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_alignParentStart="true"
                app:itvFontFamily="@font/bangla_medium"
                app:itvIcon="@drawable/outline_android_wifi_3_bar_24"

                app:itvIconAlignment="start"
                app:itvIconColor="@color/black"
                app:itvIconPaddingEnd="@dimen/_5dp"
                app:itvIconSize="@dimen/_15dp"

                app:itvText="Internet"
                app:itvTextColor="@color/black"
                app:itvTextSize="@dimen/_11sp" />


            <com.holystock.newmyoffer.views.IconTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"

                app:itvFontFamily="@font/bangla_medium"
                app:itvIcon="@drawable/baseline_card_giftcard_24"
                app:itvIconAlignment="start"
                app:itvIconColor="@color/primary"

                app:itvIconPaddingEnd="@dimen/_5dp"
                app:itvIconSize="@dimen/_15dp"
                app:itvText="Cashback: ৳9"
                app:itvTextColor="@color/primary"
                app:itvTextSize="@dimen/_11sp" />


        </RelativeLayout>

        <TextView

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/bangla_bold"
            android:lineSpacingMultiplier="0.75"
            android:maxLines="3"
            android:text="যদি সব Android version-এ"
            android:textColor="@color/primary"
            android:textSize="@dimen/_14sp" />


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.holystock.newmyoffer.views.IconTextView
                android:id="@+id/visibility"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                app:itvFontFamily="@font/bangla_medium"
                app:itvIcon="@drawable/outline_date_range_24"

                app:itvIconAlignment="start"
                app:itvIconColor="@color/black"
                app:itvIconPaddingEnd="@dimen/_5dp"
                app:itvIconSize="@dimen/_15dp"

                app:itvText="30 Days"
                app:itvTextColor="@color/black"
                app:itvTextSize="@dimen/_11sp" />


            <com.holystock.newmyoffer.views.IconTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/visibility"
                android:layout_alignParentStart="true"
                app:itvFontFamily="@font/bangla_medium"
                app:itvIcon="@drawable/payments_24dp"
                app:itvIconAlignment="start"
                app:itvIconColor="@color/black"

                app:itvIconPaddingEnd="@dimen/_5dp"
                app:itvIconSize="@dimen/_15dp"
                app:itvText="৳ 309"
                app:itvTextColor="@color/black"
                app:itvTextSize="@dimen/_11sp" />


            <com.holystock.newmyoffer.views.BorderView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                app:bgColor="@color/primaryLight"
                app:borderWidth="@dimen/_0dp"
                app:cornerRadius="@dimen/_20dp">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_15dp"
                    android:layout_marginVertical="@dimen/_5dp"
                    android:fontFamily="@font/bangla_medium"
                    android:text="Bay"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/_13sp" />


            </com.holystock.newmyoffer.views.BorderView>

        </RelativeLayout>


    </LinearLayout>


</com.google.android.material.card.MaterialCardView>