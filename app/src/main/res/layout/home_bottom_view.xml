<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_80dp"
    android:layout_alignParentBottom="true"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/_1dp"
        android:background="@color/beautifulWhite" />

    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blurView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_80dp"
        android:background="#40FFFFFF">


        <LinearLayout
            android:baselineAligned="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:weightSum="4">

            <!-- HOME -->
            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgHome"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/home"
                    app:tint="@color/primary" />


                <TextView
                    android:id="@+id/txtHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_3dp"
                    android:fontFamily="@font/bangla_medium"
                    android:text="Home"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/_11sp" />

            </LinearLayout>

            <!-- LIVE CHAT -->
            <LinearLayout
                android:id="@+id/navChat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgChat"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/chat"
                    app:tint="@color/black" />

                <TextView
                    android:id="@+id/txtChat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_3dp"
                    android:fontFamily="@font/bangla_medium"
                    android:text="Live Chat"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11sp" />

            </LinearLayout>

            <!-- SCAN -->
            <LinearLayout
                android:id="@+id/navScan"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgScan"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/scan"
                    app:tint="@color/black" />

                <TextView
                    android:id="@+id/txtScan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_3dp"
                    android:fontFamily="@font/bangla_medium"
                    android:text="Scan"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_11sp" />

            </LinearLayout>

            <!-- INBOX -->
            <LinearLayout
                android:id="@+id/navInbox"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgInbox"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/inbox"
                    app:tint="@color/black" />

                <TextView
                    android:id="@+id/txtInbox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_3dp"
                    android:fontFamily="@font/bangla_medium"
                    android:text="Inbox"
                    android:textColor="#808080"
                    android:textSize="@dimen/_11sp" />

            </LinearLayout>


        </LinearLayout>


    </eightbitlab.com.blurview.BlurView>


</LinearLayout>